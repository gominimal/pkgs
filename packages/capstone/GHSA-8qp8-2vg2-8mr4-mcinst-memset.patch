From cc6f8e0767738fc51c12eda6492d420e5db2c7a2 Mon Sep 17 00:00:00 2001
From: Rot127 <45763064+Rot127@users.noreply.github.com>
Date: Thu, 13 Aug 2026 10:00:07 +0000
Subject: [PATCH] memset MCInst on init. (#3032)

Since everybody figured out how to script an
LLM vulnerability scanner, we get an annoying amount of
"use of uninitialized memory" reports.

MCInst is stack memory here, so I doubt this has
an impact on performance.
---
 MCInst.c | 19 +++----------------
 1 file changed, 3 insertions(+), 16 deletions(-)

diff --git a/MCInst.c b/MCInst.c
index 1e876ce2..8529130e 100644
--- a/MCInst.c
+++ b/MCInst.c
@@ -18,23 +18,10 @@
 
 void MCInst_Init(MCInst *inst)
 {
-	// unnecessary to initialize in loop . its expensive and inst->size shuold be honored
-	inst->Operands[0].Kind = kInvalid;
-	inst->Operands[0].ImmVal = 0;
-
-	inst->Opcode = 0;
-	inst->OpcodePub = 0;
-	inst->size = 0;
-	inst->has_imm = false;
-	inst->op1_size = 0;
-	inst->writeback = false;
-	inst->ac_idx = 0;
-	inst->popcode_adjust = 0;
-	inst->assembly[0] = '\0';
-	inst->wasm_data.type = WASM_OP_INVALID;
-	inst->xAcquireRelease = 0;
-	for (int i = 0; i < MAX_MC_OPS; ++i)
+	memset(inst, 0, sizeof(MCInst));
+	for (int i = 0; i < MAX_MC_OPS; ++i) {
 		inst->tied_op_idx[i] = -1;
+	}
 }
 
 void MCInst_clear(MCInst *inst)

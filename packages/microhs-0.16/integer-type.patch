+-- Split a machine word into base-2^shiftD digits, least significant first.
+-- (A 64-bit word needs up to four 16-bit digits; the original split into
+-- exactly two, leaving an oversized "high" digit for values >= 2^32.)
+wordDigits :: Word -> [Digit]
+wordDigits w =
+  if w `primWordEQ` 0 then [] else remMaxD w : wordDigits (quotMaxD w)

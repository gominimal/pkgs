# BEDROCK VARIANT (amd) of the diffutils root — generated by bin/queue/mk-arm-root.sh.
#
# Same deps as packages/diffutils, DIFFERENT SPEC NAME, and NO replace_on_cycle. The name change
# is what keeps it out of its own transitive dep set, so it is not BOUND and builds FROM
# SOURCE against our hex0-rooted gcc/binutils/glibc roots. The breaker is removed because a
# second spec declaring "diffutils (prebuilt)" makes the planner refuse outright.
#
# This is NOT a retirement: diffutils stays bound and keeps its breaker. This produces the
# ARTIFACT that lets that breaker point at something we built instead of downloaded.
let { standaloneTest, Attrs, BuildSpec, Local, OutputBin, OutputData, OutputLib, Source, Test, .. } = import "minimal.ncl" in
let { target, .. } = import "config.ncl" in
let bash-bootstrap = import "../bash-bootstrap/build.ncl" in
let binutils = import "../binutils/build.ncl" in
let coreutils = import "../coreutils/build.ncl" in
let diffutils = import "../diffutils/build.ncl" in
let gawk-bootstrap = import "../gawk-bootstrap/build.ncl" in
let gcc = import "../gcc/build.ncl" in
let glibc = import "../glibc/build.ncl" in
let grep = import "../grep/build.ncl" in
let make = import "../make/build.ncl" in
let linux_headers = import "../linux_headers/build.ncl" in
let sed = import "../sed/build.ncl" in
let tar = import "../tar/build.ncl" in

let version = "3.12" in
{
  name = "stage0-diffutils-amd",
  build_deps = [
    { file = "build.sh" } | Local,
    {
      url = "gs://minimal-staging-archives/diffutils-%{version}.tar.xz",
      sha256 = "7c8b7f9fc8609141fdea9cece85249d308624391ff61dedaf528fcb337727dfd",
      extract = true,
    } | Source,
    bash-bootstrap,
    binutils,
    coreutils,
    diffutils,
    gawk-bootstrap,
    gcc,
    glibc,
    grep,
    make,
    linux_headers,
    sed,
    tar,
  ],
  runtime_deps = [
    glibc,
  ],

  cmd = "./build.sh",
  build_args = {
    include version,
  },

  outputs = {
    # catch-all: a promotion must be a content SUPERSET of the slot it replaces.
    slot_all = { glob = "usr/**" } | OutputData,
    cmp = { glob = "usr/bin/cmp" } | OutputBin,
    diff = { glob = "usr/bin/diff" } | OutputBin,
    diff3 = { glob = "usr/bin/diff3" } | OutputBin,
    sdiff = { glob = "usr/bin/sdiff" } | OutputBin,

    mans = { glob = "usr/share/man/**" } | OutputData,
    infos = { glob = "usr/share/info/*.info" } | OutputData,
    locales = { glob = "usr/share/locale/**" } | OutputData,
  },

  attrs =
    {
      upstream_version = version,
      license_spdx = "GPL-3.0-only",
      source_provenance = {
        category = 'GnuProject,
        name = "diffutils",
      },
    } | Attrs,

  tests = {
    smoketest = standaloneTest "/bin/cmp --version",

    diff =
      {
        class = 'Standalone,
        test_deps = [bash-bootstrap, coreutils],
        cmds = [
          ["/bin/bash", "-c", "echo 'hello world' > test1.txt"],
          ["/bin/bash", "-c", "echo 'hello whrld' > test2.txt"],
          # Differs
          ["/bin/bash", "-c", "diff -q test1.txt test2.txt || echo worked"],
          # Matches
          ["/bin/diff", "-q", "test2.txt", "test2.txt"],
        ],
      } | Test,
  },
} | BuildSpec

let { Local, .. } = import "minimal.ncl" in
# The licence installer and the third-party notices for the code the Mathlib
# build compiles in. ONE definition, imported by both packages that ship that
# code: `mathlib` and `mathlib-oleans` (which a user can install on its own).
# A Local's path is relative to the .ncl file that names it, so these resolve
# to packages/mathlib/ from either package.
[
  # Run by both build.sh files: installs every upstream LICENSE and the four
  # notices below, after checking each against the pinned ProofWidgets.
  { file = "install-licences.sh" } | Local,
  # Licence inventory of the npm code bundled in ProofWidgets' widget JS,
  # generated from its pinned package-lock.json (gen-proofwidgets-notice.py
  # --inventory; install-licences.sh checks the hash).
  { file = "proofwidgets-js-third-party.txt" } | Local,
  # Verbatim third-party licence texts for that JS, from the exact npm
  # tarballs the lockfile resolves (gen-proofwidgets-notice.py); where a
  # tarball ships no licence file, a curated upstream text from
  # proofwidgets-js-licences/ (the generator fails without one).
  { file = "proofwidgets-js-NOTICE.txt" } | Local,
  # Licences + EPL/CPL source offer for the Graphviz WebAssembly that two of
  # those bundles embed (@hpcc-js/wasm), the Emscripten runtime compiled
  # into it, and the JS decoders hpcc inlines around it (fzstd, the basE91
  # loader); hand-assembled, hash-pinned to the bundles.
  { file = "proofwidgets-wasm-NOTICE.txt" } | Local,
  # Licence texts of every Rust crate (and the Rust std) compiled into the
  # Penrose optimizer WebAssembly that two other bundles embed
  # (@penrose/optimizer); generated by gen-proofwidgets-wasm-notice.py,
  # hash-pinned to the bundles.
  { file = "proofwidgets-penrose-wasm-NOTICE.txt" } | Local,
]

--- a/ghc/rts/MBlock.c
+++ b/ghc/rts/MBlock.c
@@ -48,13 +48,21 @@
    The MBlock Map: provides our implementation of HEAP_ALLOCED()
    -------------------------------------------------------------------------- */
 
+#if SIZEOF_VOID_P == 4
 StgWord8 mblock_map[4096]; // initially all zeros
 
 static void
 mblockIsHeap (void *p)
 {
     mblock_map[((StgWord)p & ~MBLOCK_MASK) >> MBLOCK_SHIFT] = 1;
+}
+#else
+// 4096 entries cover 4GB of 1MB megablocks; 64-bit HEAP_ALLOCED is an address test (MBlock.h)
+static void
+mblockIsHeap (void *p STG_UNUSED)
+{
 }
+#endif
 

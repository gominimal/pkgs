+extern void* DATA_SECTION_END_MARKER_DECL;
+#define HEAP_ALLOCED(x)  ((StgPtr)(x) >= (StgPtr)&DATA_SECTION_END_MARKER)
 
-#ifdef TEXT_BEFORE_HEAP

/usr/bin/cp include/sys/time.h /build/output/usr/include/sys/time.h
/usr/bin/cp include/sys/times.h /build/output/usr/include/sys/times.h
/usr/bin/cp include/sys/types.h /build/output/usr/include/sys/types.h
/usr/bin/cp include/sys/ucontext.h /build/output/usr/include/sys/ucontext.h
/usr/bin/cp include/sys/user.h /build/output/usr/include/sys/user.h
/usr/bin/cp include/sys/wait.h /build/output/usr/include/sys/wait.h

# --- header copy at an uncontended path (not in pass1.kaem) ---
# /usr/include is also written by glibc in consumer sandboxes that carry glibc-linked
# tools, and the rootfs overlay is first-writer-wins. Shell-driven consumers compile
# -nostdinc against this copy, which no other package writes.
/usr/bin/mkdir -p /build/output/usr/lib/mes-bedrock
/usr/bin/cp -rT /build/output/usr/include /build/output/usr/lib/mes-bedrock/include

# --- export the Scheme module trees (not in pass1.kaem) ---
# live-bootstrap keeps these in its persistent build tree; here the build tree is
# discarded, so the next rung's MesCC needs them shipped. Includes the regenerated
# nyacc c99 tables and psyntax.
/usr/bin/mkdir -p /build/output/usr/share/mes/module
/usr/bin/mkdir -p /build/output/usr/share/nyacc
# mes install.sh.in merges both module/ and mes/module/ into $prefix/share/mes/module/,
# and mes-m2 loads share/mes/module/mes/boot-5.scm from MES_PREFIX, so both source dirs
# go into that one directory.
/usr/bin/cp -rT /build/mes-0.27.1/module /build/output/usr/share/mes/module
/usr/bin/cp -rT /build/mes-0.27.1/mes/module /build/output/usr/share/mes/module
/usr/bin/cp -r /build/nyacc-1.00.2/module /build/output/usr/share/nyacc/module

# --- byte-identity gate ---
# Local files land in /build; CWD is /build/mes-0.27.1, so use the absolute path.
/usr/bin/sha256sum -c /build/mes.answers

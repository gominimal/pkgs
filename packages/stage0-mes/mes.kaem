# stage0-mes driver, run by the full C kaem. Port of live-bootstrap
# steps/mes-0.27.1/pass1.kaem. kaem aborts on any non-zero child, so each line is also
# an assertion. Phases: environment, source prep, mes-m2 build, nyacc table regeneration,
# mescc.scm, mes-libc compile, install, header/module export, sha256 gate.
#
# Differences from upstream pass1.kaem:
#   * arch `if match` block inlined (amd64 / x86_64 / 64-bit only).
#   * source checksum step and ungz/untar dropped: the Source pins and extract=true
#     already handle tarball integrity and unpacking under /build.
#   * `replace` and `simple-patch` replaced by sed; file utilities are coreutils.
#   * install root is DESTDIR=/build/output (/usr is read-only at build time); the
#     runtime prefix string baked into mescc.scm stays /usr (PREFIX_RT).
#   * UPDATE_CHECKSUMS if/else replaced by a single `sha256sum -c mes.answers` gate.

# --- environment ---
# PATH must include /usr/bin so the inner kaem.run finds M2-Planet/M1/hex2/blood-elf.
PATH=/usr/bin
ARCH=amd64
MES_ARCH=x86_64
ARCH_BITS=64
# inner-build variables read by kaem.x86_64 / kaem.run
cc_cpu=x86_64
mes_cpu=x86_64
stage0_cpu=amd64
blood_elf_flag=--64
# M2libc for the M2-Planet build of mes-m2 (mes 0.27.1 does not ship it)
M2LIBC_PATH=/build/stage0-posix-1.9.1/M2libc
# mes interpreter arena/stack (from pass1.kaem; raised for gen-c99-files below)
MES_ARENA=20000000
MES_MAX_ARENA=20000000
MES_STACK=6000000
MES_VERSION=0.27.1
NYACC_PKG=nyacc-1.00.2
MES_PKG=mes-0.27.1
# source trees, extracted under /build by the harness
MES_PREFIX=/build/mes-0.27.1
NYACC_DIR=/build/nyacc-1.00.2
# install tree = OUTPUT_DIR; runtime prefix string baked into mescc.scm = /usr
DESTDIR=/build/output
PREFIX=/build/output/usr
PREFIX_RT=/usr
BINDIR=/build/output/usr/bin
INCDIR=/build/output/usr/include
# build-tree libdir; mescc writes lib/x86_64-mes/* here with CWD=MES_PREFIX
LIBDIR=/build/mes-0.27.1/lib
# mes-m2 module search path (set by seed.kaem upstream)
MES=/build/output/usr/bin/mes-m2
GUILE_LOAD_PATH=/build/mes-0.27.1/mes/module:/build/mes-0.27.1/module:/build/nyacc-1.00.2/module

# --- staging dirs ---
/usr/bin/mkdir -p /build/output/usr/bin
/usr/bin/mkdir -p /build/output/usr/lib/x86_64-mes
/usr/bin/mkdir -p /build/output/usr/lib/linux/x86_64-mes
/usr/bin/mkdir -p /build/output/usr/include/mes
/usr/bin/mkdir -p /build/output/usr/include/sys
/usr/bin/mkdir -p /build/output/usr/include/linux/x86_64
/usr/bin/mkdir -p /build/output/usr/include/arch

# --- prepare the mes source tree (pass1.kaem lines 42-63) ---
# Set mes-m2's link base address to 0x8048000, as pass1.kaem does on every arch.
# kaem passes single quotes literally, so the sed expression is a bare token with no spaces.
/usr/bin/sed -i s|0x1000000|0x8048000|g /build/mes-0.27.1/kaem.run

# config.h (Local file, lands in /build)
/usr/bin/cp /build/config.h /build/mes-0.27.1/include/mes/config.h

# wait4 fix (upstreamed after 0.27.1): insert `  *long_status_ptr = 0;` after the rusage line.
# The expression has spaces so it uses kaem's `"` quoting; `\\` yields a single `\` for `a\`.
# wait4.c feeds libc.a, whose sha is in mes.answers, so a wrong insertion fails the gate.
/usr/bin/sed -i "/  long long_rusage = cast_voidp_to_long (rusage);/a\\  *long_status_ptr = 0;" /build/mes-0.27.1/lib/linux/wait4.c

cd /build/mes-0.27.1
# The tarball has no include/arch/; pass1.kaem creates it and so must we.
/usr/bin/mkdir -p include/arch
# arch header copies (pass1.kaem lines 53-56)
/usr/bin/cp include/linux/x86_64/kernel-stat.h include/arch/kernel-stat.h
/usr/bin/cp include/linux/x86_64/signal.h include/arch/signal.h
/usr/bin/cp include/linux/x86_64/syscall.h include/arch/syscall.h

# Remove pregenerated files so mes-m2 regenerates them from source.
/usr/bin/rm mes/module/mes/psyntax.pp mes/module/mes/psyntax.pp.header

# These are symlinks in the tarball; replace them with real copies. The harness's
# extract materializes the symlinks (upstream's untar skips them), so `cp src dst` would
# be a same-file error without the rm first.
/usr/bin/rm -f mes/module/srfi/srfi-9.mes mes/module/srfi/srfi-9/gnu.mes
/usr/bin/cp mes/module/srfi/srfi-9-struct.mes mes/module/srfi/srfi-9.mes
/usr/bin/cp mes/module/srfi/srfi-9/gnu-struct.mes mes/module/srfi/srfi-9/gnu.mes

# --- build mes-m2 (pass1.kaem lines 66-68) ---
# kaem.x86_64 sets the cpu variables, then runs kaem.run: M2-Planet -> M1 -> hex2 on mes.c.
/usr/bin/kaem --verbose --strict --file kaem.x86_64
/usr/bin/cp bin/mes-m2 /build/output/usr/bin/mes-m2
/usr/bin/chmod 755 /build/output/usr/bin/mes-m2

# --- regenerate nyacc parser tables with mes-m2 (pass1.kaem lines 71-82) ---
cd /build/nyacc-1.00.2
/usr/bin/rm module/nyacc/lang/c99/mach.d/c99-act.scm module/nyacc/lang/c99/mach.d/c99-tab.scm \
    module/nyacc/lang/c99/mach.d/c99cx-act.scm module/nyacc/lang/c99/mach.d/c99cx-tab.scm \
    module/nyacc/lang/c99/mach.d/c99x-act.scm module/nyacc/lang/c99/mach.d/c99x-tab.scm \
    module/nyacc/lang/c99/mach.d/cpp-act.scm module/nyacc/lang/c99/mach.d/cpp-tab.scm
/build/output/usr/bin/mes-m2 -L module gen-cpp-files.scm
# gen-c99-files needs a bigger arena
MES_ARENA=32000000
/build/output/usr/bin/mes-m2 -L module gen-c99-files.scm
MES_ARENA=20000000
/build/output/usr/bin/mes-m2 -L module gen-c99cx-files.scm
cd /build/mes-0.27.1

# --- create mescc.scm (pass1.kaem lines 85-93) ---
# @prefix@ -> /usr (PREFIX_RT, the runtime prefix). Bare sed tokens: kaem passes single
# quotes literally.
/usr/bin/sed -i s|@prefix@|/usr|g scripts/mescc.scm.in
/usr/bin/sed -i s|@VERSION@|0.27.1|g scripts/mescc.scm.in
/usr/bin/sed -i s|@mes_cpu@|x86_64|g scripts/mescc.scm.in
/usr/bin/sed -i s|@mes_kernel@|linux|g scripts/mescc.scm.in
# The three shebang placeholders. mescc.scm is run via `mes-m2 -e main`, so the guile
# shebang is inert; fixed values keep the file deterministic. This is why the mescc.scm
# sha in mes.answers differs from live-bootstrap's environment-specific one.
/usr/bin/sed -i s|@GUILE@|/usr/bin/guile|g scripts/mescc.scm.in
/usr/bin/sed -i s|@guile_site_dir@|/usr/share/guile/site/2.2|g scripts/mescc.scm.in
/usr/bin/sed -i s|@guile_site_ccache_dir@|/usr/lib/guile/2.2/site-ccache|g scripts/mescc.scm.in
/usr/bin/cp scripts/mescc.scm.in /build/output/usr/bin/mescc.scm
/usr/bin/chmod 755 /build/output/usr/bin/mescc.scm

# --- compile mes-libc with mes-m2 + MesCC (pass1.kaem lines 97-285) ---
alias mescc="/build/output/usr/bin/mes-m2 -e main /build/output/usr/bin/mescc.scm -D HAVE_CONFIG_H=1 -I include -I include/linux/x86_64 -c"

# crt1.o
mescc lib/linux/x86_64-mes-mescc/crt1.c -o lib/x86_64-mes/crt1.o

# libc-mini.a
/usr/bin/catm libc-mini.c \
 lib/mes/__init_io.c \
 lib/mes/eputs.c \
 lib/mes/oputs.c \
 lib/mes/globals.c \
 lib/stdlib/exit.c \
 lib/linux/x86_64-mes-mescc/_exit.c \
 lib/linux/x86_64-mes-mescc/_write.c \
 lib/stdlib/puts.c \
 lib/string/strlen.c
mescc libc-mini.c
/usr/bin/cp libc-mini.o /build/mes-0.27.1/lib/x86_64-mes/libc-mini.a
/usr/bin/cp libc-mini.s /build/mes-0.27.1/lib/x86_64-mes/libc-mini.s

# libmescc.a
/usr/bin/catm libmescc.c \
 lib/mes/globals.c \
 lib/linux/x86_64-mes-mescc/syscall-internal.c
mescc libmescc.c
/usr/bin/cp libmescc.o /build/mes-0.27.1/lib/x86_64-mes/libmescc.a
/usr/bin/cp libmescc.s /build/mes-0.27.1/lib/x86_64-mes/libmescc.s

# libc.a
/usr/bin/catm libc.c \
 lib/ctype/isnumber.c \
 lib/mes/abtol.c \
 lib/mes/cast.c \
 lib/mes/eputc.c \
 lib/mes/fdgetc.c \
 lib/mes/fdputc.c \
 lib/mes/fdputs.c \
 lib/mes/fdungetc.c \
 lib/mes/itoa.c \
 lib/mes/ltoa.c \
 lib/mes/ltoab.c \
 lib/mes/mes_open.c \
 lib/mes/ntoab.c \
 lib/mes/oputc.c \
 lib/mes/ultoa.c \
 lib/mes/utoa.c \
 lib/ctype/isdigit.c \
 lib/ctype/isspace.c \
 lib/ctype/isxdigit.c \
 lib/mes/assert_msg.c \
 lib/posix/write.c \
 lib/stdlib/atoi.c \
 lib/linux/lseek.c \
 lib/mes/__assert_fail.c \
 lib/mes/__buffered_read.c \
 lib/mes/__mes_debug.c \
 lib/posix/execv.c \
 lib/posix/getcwd.c \
 lib/posix/getenv.c \
 lib/posix/isatty.c \
 lib/posix/open.c \
 lib/posix/buffered-read.c \
 lib/posix/setenv.c \
 lib/posix/wait.c \
 lib/dirent/closedir.c \
 lib/dirent/opendir.c \
 lib/stdio/fgetc.c \
 lib/stdio/fputc.c \
 lib/stdio/fputs.c \
 lib/stdio/getc.c \
 lib/stdio/getchar.c \
 lib/stdio/putc.c \
 lib/stdio/putchar.c \
 lib/stdio/ungetc.c \
 lib/stdlib/calloc.c \
 lib/stdlib/free.c \
 lib/stdlib/realloc.c \
 lib/string/memchr.c \
 lib/string/memcmp.c \
 lib/string/memcpy.c \
 lib/string/memmove.c \
 lib/string/memset.c \
 lib/string/strcmp.c \
 lib/string/strcpy.c \
 lib/string/strncmp.c \
 lib/posix/raise.c \
 lib/linux/access.c \
 lib/linux/brk.c \
 lib/linux/chdir.c \
 lib/linux/chmod.c \
 lib/linux/clock_gettime.c \
 lib/linux/dup.c \
 lib/linux/dup2.c \
 lib/linux/execve.c \
 lib/linux/fork.c \
 lib/linux/fsync.c \
 lib/linux/_getcwd.c \
 lib/linux/gettimeofday.c \
 lib/linux/ioctl3.c \
 lib/linux/malloc.c \
 lib/linux/_open3.c \
 lib/linux/_read.c \
 lib/linux/readdir.c \
 lib/linux/rename.c \
 lib/linux/time.c \
 lib/linux/umask.c \
 lib/linux/uname.c \
 lib/linux/unlink.c \
 lib/linux/utimensat.c \
 lib/linux/wait4.c \
 lib/linux/waitpid.c \
 lib/linux/x86_64-mes-mescc/syscall.c \
 lib/linux/getpid.c \
 lib/linux/kill.c \
 lib/linux/pipe.c \
 lib/linux/stat.c \
 lib/linux/lstat.c \
 lib/linux/mkdir.c \
 lib/linux/rmdir.c \
 lib/linux/link.c \
 lib/linux/symlink.c \
 lib/linux/close.c \
 lib/linux/nanosleep.c \
 lib/linux/fcntl.c \
 lib/linux/fstat.c \
 lib/linux/getdents.c
mescc libc.c
/usr/bin/catm /build/mes-0.27.1/lib/x86_64-mes/libc.a /build/mes-0.27.1/lib/x86_64-mes/libc-mini.a libc.o
/usr/bin/catm /build/mes-0.27.1/lib/x86_64-mes/libc.s /build/mes-0.27.1/lib/x86_64-mes/libc-mini.s libc.s

# libc+tcc.a
/usr/bin/catm libc+tcc.c \
 lib/ctype/islower.c \
 lib/ctype/isupper.c \
 lib/ctype/tolower.c \
 lib/ctype/toupper.c \
 lib/mes/abtod.c \
 lib/mes/dtoab.c \
 lib/mes/search-path.c \
 lib/posix/execvp.c \
 lib/stdio/fclose.c \
 lib/stdio/fdopen.c \
 lib/stdio/ferror.c \
 lib/stdio/fflush.c \
 lib/stdio/fopen.c \
 lib/stdio/fprintf.c \
 lib/stdio/fread.c \
 lib/stdio/fseek.c \
 lib/stdio/ftell.c \
 lib/stdio/fwrite.c \
 lib/stdio/printf.c \
 lib/stdio/remove.c \
 lib/stdio/snprintf.c \
 lib/stdio/sprintf.c \
 lib/stdio/sscanf.c \
 lib/stdio/vfprintf.c \
 lib/stdio/vprintf.c \
 lib/stdio/vsnprintf.c \
 lib/stdio/vsprintf.c \
 lib/stdio/vsscanf.c \
 lib/stdlib/abort.c \
 lib/stdlib/qsort.c \
 lib/stdlib/strtod.c \
 lib/stdlib/strtof.c \
 lib/stdlib/strtol.c \
 lib/stdlib/strtold.c \
 lib/stdlib/strtoll.c \
 lib/stdlib/strtoul.c \
 lib/stdlib/strtoull.c \
 lib/string/memmem.c \
 lib/string/strcat.c \
 lib/string/strchr.c \
 lib/string/strlwr.c \
 lib/string/strncpy.c \
 lib/string/strrchr.c \
 lib/string/strstr.c \
 lib/string/strupr.c \

/usr/bin/cp include/math.h /build/output/usr/include/math.h
/usr/bin/cp include/memory.h /build/output/usr/include/memory.h
/usr/bin/cp include/pwd.h /build/output/usr/include/pwd.h
/usr/bin/cp include/setjmp.h /build/output/usr/include/setjmp.h
/usr/bin/cp include/signal.h /build/output/usr/include/signal.h
/usr/bin/cp include/stdarg.h /build/output/usr/include/stdarg.h
/usr/bin/cp include/linux/x86_64/signal.h /build/output/usr/include/arch/signal.h
/usr/bin/cp include/stdbool.h /build/output/usr/include/stdbool.h
/usr/bin/cp include/stddef.h /build/output/usr/include/stddef.h
/usr/bin/cp include/stdint.h /build/output/usr/include/stdint.h
/usr/bin/cp include/stdio.h /build/output/usr/include/stdio.h
/usr/bin/cp include/stdlib.h /build/output/usr/include/stdlib.h
/usr/bin/cp include/stdnoreturn.h /build/output/usr/include/stdnoreturn.h
/usr/bin/cp include/string.h /build/output/usr/include/string.h

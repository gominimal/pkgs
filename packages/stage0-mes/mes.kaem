/usr/bin/cp include/time.h /build/output/usr/include/time.h
/usr/bin/cp include/unistd.h /build/output/usr/include/unistd.h

/usr/bin/cp include/arch/kernel-stat.h /build/output/usr/include/arch/kernel-stat.h
/usr/bin/cp include/arch/syscall.h /build/output/usr/include/arch/syscall.h

/usr/bin/cp include/linux/syscall.h /build/output/usr/include/linux/syscall.h
/usr/bin/cp include/linux/x86_64/syscall.h /build/output/usr/include/linux/x86_64/syscall.h

/usr/bin/cp include/mes/builtins.h /build/output/usr/include/mes/builtins.h
/usr/bin/cp include/mes/cc.h /build/output/usr/include/mes/cc.h
# catm with one argument creates an empty installed config.h, as pass1.kaem does
/usr/bin/catm /build/output/usr/include/mes/config.h
/usr/bin/cp include/mes/constants.h /build/output/usr/include/mes/constants.h
/usr/bin/cp include/mes/lib.h /build/output/usr/include/mes/lib.h
/usr/bin/cp include/mes/lib-cc.h /build/output/usr/include/mes/lib-cc.h
/usr/bin/cp include/mes/lib-mini.h /build/output/usr/include/mes/lib-mini.h
/usr/bin/cp include/mes/mes.h /build/output/usr/include/mes/mes.h
/usr/bin/cp include/mes/symbols.h /build/output/usr/include/mes/symbols.h

/usr/bin/cp include/sys/cdefs.h /build/output/usr/include/sys/cdefs.h
/usr/bin/cp include/sys/dir.h /build/output/usr/include/sys/dir.h
/usr/bin/cp include/sys/file.h /build/output/usr/include/sys/file.h

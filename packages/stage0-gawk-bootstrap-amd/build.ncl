# BEDROCK VARIANT (amd) of the gawk-bootstrap root — generated by bin/queue/mk-arm-root.sh.
#
# Same deps as packages/gawk-bootstrap, DIFFERENT SPEC NAME, and NO replace_on_cycle. The name change
# is what keeps it out of its own transitive dep set, so it is not BOUND and builds FROM
# SOURCE against our hex0-rooted gcc/binutils/glibc roots. The breaker is removed because a
# second spec declaring "gawk-bootstrap (prebuilt)" makes the planner refuse outright.
#
# This is NOT a retirement: gawk-bootstrap stays bound and keeps its breaker. This produces the
# ARTIFACT that lets that breaker point at something we built instead of downloaded.
let { BuildSpec, Local, OutputBin, OutputData, OutputLib, Source, .. } = import "minimal.ncl" in
let { target, .. } = import "config.ncl" in
let base-bootstrap = import "../base-bootstrap/build.ncl" in
let make = import "../make/build.ncl" in
let toolchain = import "../toolchain/build.ncl" in

let glibc = import "../glibc/build.ncl" in
let mpfr = import "../mpfr/build.ncl" in

let version = "5.4.1" in
{
  name = "stage0-gawk-bootstrap-amd",
  build_deps = [
    { file = "build.sh" } | Local,
    {
      url = "gs://minimal-staging-archives/gawk-%{version}.tar.xz",
      sha256 = "07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37"
    } | Source,
    base-bootstrap,
    make,
    toolchain,
  ],
  runtime_deps = [
    glibc,
    mpfr,
  ],

  cmd = "./build.sh",
  outputs = {
    # catch-all: a promotion must be a content SUPERSET of the slot it replaces.
    slot_all = { glob = "usr/**" } | OutputData,
    gawk_versioned = { glob = "usr/bin/gawk-*" } | OutputBin,
    gawk = { glob = "usr/bin/gawk" } | OutputBin,
    awk = { glob = "usr/bin/awk" } | OutputBin,
    libs = { glob = "usr/lib/gawk/*.so" } | OutputLib,
    libexec = { glob = "usr/libexec/awk/*" } | OutputLib,

    includes = { glob = "usr/include/**" } | OutputData,

    awk_data = { glob = "usr/share/awk/*" } | OutputData,
    mans = { glob = "usr/share/man/**" } | OutputData,
    locales = { glob = "usr/share/locale/**" } | OutputData,
  },

  attrs = {
    upstream_version = version,
    source_provenance = {
      category = 'GnuProject,
      name = "gawk",
    },
    license_spdx = "GPL-3.0-only",
  },

} | BuildSpec

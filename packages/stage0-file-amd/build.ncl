# BEDROCK VARIANT (amd) of the file root — generated by bin/queue/mk-arm-root.sh.
#
# Same deps as packages/file, DIFFERENT SPEC NAME, and NO replace_on_cycle. The name change
# is what keeps it out of its own transitive dep set, so it is not BOUND and builds FROM
# SOURCE against our hex0-rooted gcc/binutils/glibc roots. The breaker is removed because a
# second spec declaring "file (prebuilt)" makes the planner refuse outright.
#
# This is NOT a retirement: file stays bound and keeps its breaker. This produces the
# ARTIFACT that lets that breaker point at something we built instead of downloaded.
let { Attrs, BuildSpec, Local, OutputBin, OutputData, OutputLib, Source, .. } = import "minimal.ncl" in
let { target, .. } = import "config.ncl" in
let bash-bootstrap = import "../bash-bootstrap/build.ncl" in
let tar = import "../tar/build.ncl" in
let make = import "../make/build.ncl" in
let sed = import "../sed/build.ncl" in
let gawk-bootstrap = import "../gawk-bootstrap/build.ncl" in
let grep = import "../grep/build.ncl" in
let coreutils = import "../coreutils/build.ncl" in
let toolchain = import "../toolchain/build.ncl" in

let glibc = import "../glibc/build.ncl" in
let lz4 = import "../lz4/build.ncl" in
let xz = import "../xz/build.ncl" in
let version = "5.48" in
{
  name = "stage0-file-amd",
  build_deps = [
    { file = "build.sh" } | Local,
    {
      # Home page: https://www.darwinsys.com/file/
      # https://astron.com/pub/file/file-5.48.tar.gz
      url = "gs://minimal-staging-archives/file-%{version}.tar.gz",
      sha256 = "ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283"
    } | Source,
    bash-bootstrap,
    tar,
    make,
    sed,
    gawk-bootstrap,
    grep,
    coreutils,
    toolchain,
  ],
  runtime_deps = [
    glibc,
    lz4,
    xz,
  ],

  cmd = "./build.sh",
  build_args = {
    include version,
  },

  outputs = {
    # catch-all: a promotion must be a content SUPERSET of the slot it replaces.
    slot_all = { glob = "usr/**" } | OutputData,
    file = { glob = "usr/bin/file" } | OutputBin,

    libmagic = { glob = "usr/lib/libmagic.so*" } | OutputLib,
    data = { glob = "usr/share/misc/magic*" } | OutputData,

    includes = { glob = "usr/include/**" } | OutputData,
  },

  attrs =
    {
      upstream_version = version,
      license_spdx = "BSD-2-Clause-Darwin",
    } | Attrs,
} | BuildSpec

# BEDROCK VARIANT (amd) of the bison root — generated by bin/queue/mk-arm-root.sh.
#
# Same deps as packages/bison, DIFFERENT SPEC NAME, and NO replace_on_cycle. The name change
# is what keeps it out of its own transitive dep set, so it is not BOUND and builds FROM
# SOURCE against our hex0-rooted gcc/binutils/glibc roots. The breaker is removed because a
# second spec declaring "bison (prebuilt)" makes the planner refuse outright.
#
# This is NOT a retirement: bison stays bound and keeps its breaker. This produces the
# ARTIFACT that lets that breaker point at something we built instead of downloaded.
let { Attrs, BuildSpec, Local, OutputBin, OutputData, OutputLib, Source, .. } = import "minimal.ncl" in
let { target, .. } = import "config.ncl" in

# /usr/bin/bison execs m4 at runtime (the grammar tables are expanded by an m4
# subprocess). Without m4 in the runtime closure bison fails at runtime with
# "/usr/bin/bison: m4 subprocess failed: No such file or directory". m4 is
# therefore a genuine runtime_dep (in addition to a build_dep), declared below.
let base = import "../base/build.ncl" in
let flex = import "../flex/build.ncl" in
let m4 = import "../m4/build.ncl" in
let make = import "../make/build.ncl" in
let toolchain = import "../toolchain/build.ncl" in
let bash = import "../bash/build.ncl" in
let glibc = import "../glibc/build.ncl" in

let version = "3.8.2" in
{
  name = "stage0-bison-amd",
  build_deps = [
    {
      url = "gs://minimal-staging-archives/bison-%{version}.tar.xz",
      sha256 = "9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2"
    } | Source,
    { file = "build.sh" } | Local,
    base,
    make,
    flex,
    m4,
    toolchain,
  ],
  runtime_deps = [
    bash, # yacc is a shell script
    glibc,
    m4, # /usr/bin/bison spawns m4 at runtime to expand grammar tables
  ],

  cmd = "./build.sh",
  outputs = {
    # catch-all: a promotion must be a content SUPERSET of the slot it replaces.
    slot_all = { glob = "usr/**" } | OutputData,
    bison = { glob = "usr/bin/bison" } | OutputBin,
    yacc = { glob = "usr/bin/yacc" } | OutputBin,

    liby = { glob = "usr/lib/liby.a" } | OutputLib,

    bison_share = { glob = "usr/share/bison/**/*" } | OutputData,
    mans = { glob = "usr/share/man/**" } | OutputData,
    locales = { glob = "usr/share/locale/**" } | OutputData,
    aclocals = { glob = "usr/share/aclocal/*" } | OutputData,
  },

  attrs =
    {
      upstream_version = version,
      license_spdx = "GPL-3.0-only",
      source_provenance = {
        category = 'GnuProject,
        name = "bison",
      },
    } | Attrs,
} | BuildSpec

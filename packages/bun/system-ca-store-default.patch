   STACK_OF(X509) *root_extra_cert_instances = default_ca_certificates->root_extra_cert_instances;
 
+  // minimal: the compiled-in roots only go in for upstream's store, or when
+  // the system store is empty (no ca-certificates installed), so bun keeps
+  // working rather than trust nothing. --use-openssl-ca leaves them out
+  // either way, as upstream does from oven-sh/bun#46542.
+  bool minimal_bundled = minimal_upstream_ca_store();
+  if (!minimal_bundled && Bun__Node__CAStore == MINIMAL_CA_SYSTEM) {
+    STACK_OF(X509) *minimal_system = us_get_root_system_cert_instances();
+    minimal_bundled = minimal_system == NULL || sk_X509_num(minimal_system) <= 0;
+  }

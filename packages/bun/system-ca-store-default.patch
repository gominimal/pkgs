+// asked for with --use-bundled-ca or the NODE_USE_SYSTEM_CA opt-out. An
+// explicit --use-openssl-ca beats the environment opt-out.
+static bool minimal_upstream_ca_store() {
+  return Bun__Node__MinimalCAStore == MINIMAL_CA_BUNDLED ||
+         (Bun__Node__MinimalCAStore == MINIMAL_CA_SYSTEM && minimal_system_ca_opted_out());
+}

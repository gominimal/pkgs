@@ -1,7 +1,9 @@
 #include "./root_certs_header.h"
 #include "./internal/internal.h"
 #include <mutex>
+#include <stdint.h>
 #include <string.h>
+#include <strings.h>
 #include <string_view>
 #include <unordered_set>
 #include <vector>
@@ -51,17 +53,36 @@ static void us_cert_file_into_bio(void *ctx, const uint8_t *data, size_t len) {
 // External variable from Zig CLI arguments
 extern "C" bool Bun__Node__UseSystemCA;
 
+// minimal: the system CA store replaces the compiled-in roots by default.
+// Bun__Node__CAStore is src/runtime/cli/Arguments.rs's BunCAStore, repr(u8)
+// { Bundled, Openssl, System }. This patch changes its default from Bundled to
+// System, so it reads Bundled only after an explicit --use-bundled-ca.
+extern "C" uint8_t Bun__Node__CAStore;
+enum { MINIMAL_CA_BUNDLED = 0, MINIMAL_CA_OPENSSL = 1, MINIMAL_CA_SYSTEM = 2 };
+
+// minimal: NODE_USE_SYSTEM_CA=0 (or false/no/off) opts out of the
+// system-store default.
+static bool minimal_system_ca_opted_out() {
+  const char *v = getenv("NODE_USE_SYSTEM_CA");
+  return v && (strcmp(v, "0") == 0 || strcasecmp(v, "false") == 0 ||
+               strcasecmp(v, "no") == 0 || strcasecmp(v, "off") == 0);
+}
+
+// minimal: upstream's store (compiled-in roots plus OpenSSL's default paths),
+// asked for with --use-bundled-ca or the NODE_USE_SYSTEM_CA opt-out.
+static bool minimal_upstream_ca_store() {
+  return Bun__Node__CAStore == MINIMAL_CA_BUNDLED || minimal_system_ca_opted_out();
+}
+
 // Helper function to check if system CA should be used
-// Checks both CLI flag (--use-system-ca) and environment variable (NODE_USE_SYSTEM_CA=1)
 static bool us_should_use_system_ca() {
-  // Check CLI flag first
-  if (Bun__Node__UseSystemCA) {
-    return true;
+  // minimal: on by default; --use-openssl-ca leaves it out.
+  if (!minimal_upstream_ca_store()) {
+    return Bun__Node__CAStore == MINIMAL_CA_SYSTEM;
   }
-  
-  // Check environment variable
-  const char *use_system_ca = getenv("NODE_USE_SYSTEM_CA");
-  return use_system_ca && strcmp(use_system_ca, "1") == 0;
+  // Upstream's store: --use-system-ca / NODE_USE_SYSTEM_CA=1 still add the
+  // system roots to it, as upstream does.
+  return Bun__Node__UseSystemCA;
 }
 
 // Platform-specific system certificate loading implementations are separated:
@@ -298,10 +319,22 @@ extern "C" X509_STORE *us_get_default_ca_store() {
   }
   X509_STORE_set_flags(store, X509_V_FLAG_IGNORE_EXPIRED_TRUST_ANCHORS);
 
-  X509_LAZY_CERT_SET *bundled = us_get_bundled_root_cert_set();
-  if (bundled == NULL || !X509_STORE_add_lazy_cert_set(store, bundled)) {
-    X509_STORE_free(store);
-    return NULL;
+  // minimal: the compiled-in roots only go in for upstream's store, or when
+  // the system store is empty (no ca-certificates installed), so bun keeps
+  // working rather than trust nothing. --use-openssl-ca leaves them out
+  // either way, as upstream does from oven-sh/bun#46542.
+  bool minimal_bundled = minimal_upstream_ca_store();
+  if (!minimal_bundled && Bun__Node__CAStore == MINIMAL_CA_SYSTEM) {
+    const us_system_certs_t &minimal_system = us_get_root_system_certs();
+    minimal_bundled = minimal_system.lazy == nullptr &&
+                      (minimal_system.parsed == nullptr || sk_X509_num(minimal_system.parsed) <= 0);
+  }
+  if (minimal_bundled) {
+    X509_LAZY_CERT_SET *bundled = us_get_bundled_root_cert_set();
+    if (bundled == NULL || !X509_STORE_add_lazy_cert_set(store, bundled)) {
+      X509_STORE_free(store);
+      return NULL;
+    }
   }
 
   // What X509_STORE_set_default_paths(store) trusts: the default certificate file (above) and the default hashed

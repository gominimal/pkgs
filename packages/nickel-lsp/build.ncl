let { subsetOf, Attrs, BuildSpec, Local, OutputBin, Source, .. } = import "minimal.ncl" in
let base = import "../base/build.ncl" in
let patch = import "../patch/build.ncl" in
let gcc = import "../gcc/build.ncl" in
let glibc = import "../glibc/build.ncl" in
let rust = import "../rust/build.ncl" in
let toolchain = import "../toolchain/build.ncl" in

let version = "1.18.0" in
{
  name = "nickel-lsp",
  build_deps = [
    { file = "build.sh" } | Local,
    # Generated by `pkgmgr lock-patch`: cargo-resolved security floors for
    # upstream's Cargo.lock (floors and base sha256 in the patch header; build.sh's
    # generated block checks the base). Regenerated on every bump, never hand-edited.
    { file = "security-floors-lock.patch" } | Local,
    {
      url = "https://github.com/nickel-lang/nickel/archive/refs/tags/%{version}.tar.gz",
      sha256 = "ddcac13684c1fc174a45e0e179ff4ef9433eb08f08bbf4b386dc722cf64ab2d5",
      extract = true,
      strip_prefix = "nickel-%{version}",
    } | Source,
    base,
    patch,
    rust,
    toolchain,
  ],
  runtime_deps = [
    glibc,
    subsetOf gcc ["libgcc", "libstdcpp"],
  ],

  cmd = "./build.sh",

  outputs = {
    nls = { glob = "usr/bin/nls" } | OutputBin,
  },

  attrs =
    {
      upstream_version = version,
      license_spdx = "MIT",
      source_provenance = {
        category = 'GithubRepo,
        owner = "nickel-lang",
        repo = "nickel",
      },
      build_cost_multiple = 3,
    } | Attrs,
} | BuildSpec

# Byte-identity pins for stage0-binutils-2.41, checked from $OUTPUT_DIR by `sha256sum -c` once the
# gate at the end of build.sh is enabled. Unpinned: capture the shas from a first build, paste them
# below, then enable the gate. Paths are relative to $OUTPUT_DIR.
# <sha>  usr/bin/as
# <sha>  usr/bin/ld
# <sha>  usr/bin/ar
# <sha>  usr/bin/nm
# <sha>  usr/bin/objcopy
# <sha>  usr/bin/objdump
# <sha>  usr/bin/ranlib
# <sha>  usr/bin/readelf
# <sha>  usr/bin/strip
# <sha>  usr/lib/libbfd.a
# <sha>  usr/lib/libopcodes.a
# The x86_64-linux-gnu-<tool> entries are symlinks and are not pinned. --enable-deterministic-archives
# zeroes ar timestamps/uids so the .a files reproduce.

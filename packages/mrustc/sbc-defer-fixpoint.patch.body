+                            // ValueState::Generic (evaluated on use) — the same state
+                            // the generic-params path below produces.
+                            DEBUG("Deferred past fixpoint, inserting ungenerated: " << new_static_pair.path);
                         }
-                    };
+                    }
+
                     auto new_ent = new_static_pair.is_const
                         ? HIR::ValueItem(H::to_const(new_static))
                         : HIR::ValueItem(std::move(new_static_pair.data));
@@ -1183,8 +1230,11 @@ namespace static_borrow_constants {
                         HIR::Publicity::new_none(), // Should really be private, but we're well after checking
                         std::move(new_ent)
                         })) );
+                    ins[idx] = true;
+                    progress = true;
                 }
             }
+            }
         }
 
         void visit_module(::HIR::ItemPath p, ::HIR::Module& mod) override {
